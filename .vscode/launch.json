{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gcc.exe 独立窗口运行（鼠标可用）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\${workspaceFolderBasename}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc.exe 编译全部源文件"
        }
    ]
}
